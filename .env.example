# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key 

# Razorpay test-mode keys — only needed if you extend this to pull live settlement
# data from Razorpay's API instead of synthetic data. Not required for the MVP.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
